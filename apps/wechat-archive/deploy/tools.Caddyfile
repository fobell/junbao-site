# Append this block to the existing Caddyfile; preserve the global h1/h2 setting.
tools.junbao.ai {
  encode zstd gzip
  header {
    Alt-Svc "clear"
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Cache-Control "no-store, private"
    -Server
  }
  reverse_proxy wechat-archive-api:3000
}
