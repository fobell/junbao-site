{
  "name": "wechat-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/main.ts\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/server/main.js",
    "worker": "tsx src/worker/main.ts",
    "browser": "tsx src/browser/main.ts",
    "proxy": "tsx src/browser/proxy.ts",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "storage:migrate": "tsx scripts/storage-migrate.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:deployment && npm run build",
    "test:deployment": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/lib-storage": "3.1159.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.8",
    "@fastify/swagger": "9.5.2",
    "@tanstack/react-query": "5.90.7",
    "archiver": "7.0.1",
    "bullmq": "5.63.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "5.8.2",
    "linkedom": "0.18.12",
    "lucide-react": "0.548.0",
    "pg": "8.16.3",
    "playwright": "1.64.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "turndown": "7.2.2",
    "turndown-plugin-gfm": "1.0.2",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/archiver": "6.0.3",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sanitize-html": "2.16.0",
    "@types/turndown": "5.0.5",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.2.5",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
