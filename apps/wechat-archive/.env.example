DOMAIN=archive.example.com
APP_ORIGIN=https://archive.example.com
# Empty for standalone; a path prefix when behind a shared gateway.
APP_BASE_PATH=
# Server's real stable egress IP, used for display and WeChat IP allowlisting.
WECHAT_EGRESS_IP=
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SYNC_HOUR=3
SYNC_MINUTE=30
REQUEST_DELAY_MS=3000
# Only set this to the private CIDR of your Caddy network if desired.
TRUSTED_PROXY_CIDR=

# standalone (default) or tools (existing junbao-prompt Caddy)
DEPLOYMENT_MODE=standalone
WORKER_CONCURRENCY=2
BROWSER_MAX_SESSIONS=3
BROWSER_MAX_CONTEXTS=4
